{
  "expo": {
    "name": "Arreglemos la Calle",
    "slug": "arreglemos-la-calle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arreglemos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ar.arreglemoslacalle.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ar.arreglemoslacalle.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d3faf",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1d3faf",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para sacarle una foto al problema.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir una foto del problema.",
          "cameraPermission": "Para sacarle una foto al problema.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para saber en qué calle está el problema. Solo mientras usás la app."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
