{
  "expo": {
    "name": "Arreglemos la Calle",
    "slug": "arreglemos-la-calle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arreglemos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ar.arreglemoslacalle.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ar.arreglemoslacalle.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1F7F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F7F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para sacarle una foto al problema.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir una foto del problema.",
          "cameraPermission": "Para sacarle una foto al problema.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para saber en qué calle está el problema. Solo mientras usás la app."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-notifications",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0b77a867-3834-462e-8685-9ea620d2c506"
      }
    },
    "owner": "zagoagus"
  }
}
