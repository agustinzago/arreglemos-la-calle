# Copiá a mobile/.env. Expo solo expone a la app las variables EXPO_PUBLIC_*: nunca pongas la clave secreta acá.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Base de la página pública (/r/[id]) para Compartir y "Enviar a la Muni". Hasta que exista la web (#5), cualquier URL.
EXPO_PUBLIC_WEB_URL=https://<web>.vercel.app
