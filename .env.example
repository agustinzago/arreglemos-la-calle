# Proyecto de Supabase de TEST (los tests del contrato crean y borran datos ahí).
# Copiá este archivo a .env (está en .gitignore) y completalo desde el dashboard de Supabase.
SUPABASE_URL=https://<ref>.supabase.co
# Clave publicable (sb_publishable_…), la que la app y la web usan como "anon key".
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta (sb_secret_…, el viejo "service role"). Solo tests y scripts, nunca en la app ni en la web.
SUPABASE_SECRET_KEY=sb_secret_...
# Conexión "Session pooler" (Dashboard → Connect). Para aplicar migraciones con psql.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
